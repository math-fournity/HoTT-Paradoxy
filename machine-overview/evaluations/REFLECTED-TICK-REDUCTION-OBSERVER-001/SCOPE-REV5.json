    "cubical_control": "Cubical v0.9 source tree plus a hash-pinned 99-file project HoTT/formal snapshot; later unrelated formal-tree growth does not rewrite this evaluation denominator.",
    "proof_checking_question": "Does a fixed proof-checking run complete within its declared observation interval, and which source assumptions are responsible?"
  },
  "questions": [
    {
      "id": "R1",
      "question": "Does the exact checker expose normalise, reduce, quoteTC and unquoteTC to macros?"
    },
    {
      "id": "R2",
      "question": "Which internal tick metadata is represented or omitted by reflected ArgInfo?"
    },
    {
      "id": "R3",
      "question": "How does unquotation reconstruct omitted ArgInfo annotation data?"
    },
    {
      "id": "R4",
      "question": "Can direct macro call sites distinguish diamond and ordinary-tick reduction results?"
    },
    {
      "id": "R5",
      "question": "Can one object-level function retain that distinction while respecting force-delay Path equality?"
    },
    {
      "id": "R6",
      "question": "Can a macro-generated distinction itself form the required Path?"
    },
    {
      "id": "R7",
      "question": "Does reflected declaration cloning preserve ordinary-tick and forcing-tick binder behavior?"
    },
    {
      "id": "R8",
      "question": "Does a fixed library or formal consumer promote call-site syntax observation to an object-level operational invariant?"
    },
    {
      "id": "N1",
      "question": "Does ordinary termination checking reject an unproductive self-recursive definition?"
    },
    {
      "id": "N2",
      "question": "What changes when the source explicitly asserts termination instead of asking the checker to establish it?"
    },
    {
      "id": "N3",
      "question": "Does forcing a distinct normal form then make proof checking fail to complete within the observation interval?"
    },
    {
      "id": "N4",
      "question": "Does keeping a recursive definition opaque to type-checking reduction prevent false equality and complete with rejection?"
    },
    {
      "id": "N5",
      "question": "Does Reflection normalisation of a legitimately guarded productive infinite object stop at the delay boundary?"
    },
    {
      "id": "N6",
      "question": "Do these observations establish a HoTT-specific Gödel incompleteness or reality-relative paradox instance?"
    }
  ],
  "qualification_gates": {
    "hott_nonreality": {
      "verdict_on_pass": "HOTT_REALITY_RELATIVE_NONREALITY_CANDIDATE",
      "required_conditions": [
        "The non-completing proof-checking task uses the declared HoTT or CCTT rules without an explicit termination assertion that the checker did not establish.",
        "The exact proof obligation and theory configuration are fixed and natively replayed.",
        "The same task has a specified reality or operational counterpart rather than a stronger substituted task.",
        "The non-completion is caused by the theory abstraction or self-application being investigated.",
        "A fixed natural consumer or theory-mandated operation requires the problematic observation.",
        "Positive controls show that finite and guarded productive counterparts complete."
      ]
    },
    "godel_hott": {
      "verdict_on_pass": "HOTT_GODEL_INCOMPLETENESS_INSTANCE_CANDIDATE",
      "required_conditions": [
        "A fixed object language, coding and substitution operation are present.",
        "The relevant proof predicate or checker relation is represented at the claimed layer.",
        "The self-reference or diagonal step is explicitly constructed.",
        "The soundness, derivability or reflection assumptions used by the conclusion are named.",
        "The claimed incompleteness or non-completion follows from those fixed assumptions rather than from a manually asserted recursive equation.",
        "A HoTT/Cubical/Clocked-specific rule or natural consumer is essential to the instance."
      ]
    }
  },
