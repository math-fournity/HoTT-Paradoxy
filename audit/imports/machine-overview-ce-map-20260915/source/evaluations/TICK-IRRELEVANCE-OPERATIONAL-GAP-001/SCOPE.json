  "operational_observation": {
    "question": "Does application of this tick form make the fixed-point term unfold judgementally at the current type-checking step?",
    "forcing_tick_value": true,
    "ordinary_tick_value": false,
    "scope": "The exact reduction relation implemented by the pinned forcing-ticks checker; this is not physical elapsed time.",
    "internalisation_test": "Treat the observation as a path-respecting Bool-valued function on an internal tick type."
  },
  "questions": [
    {"id": "G1", "question": "Does the fixed source distinguish ordinary and forcing ticks operationally?"},
    {"id": "G2", "question": "Does it construct Path-level tick irrelevance between applications?"},
    {"id": "G3", "question": "Does it keep Path equality distinct from judgemental unfolding/current reduction?"},
    {"id": "G4", "question": "Can the operational distinction be internalised as a path-respecting Bool observer without collapse?"},
    {"id": "G5", "question": "Do clock abstraction, residual contexts and forcing scope retain the timing qualification?"},
    {"id": "G6", "question": "Does a fixed implementation or library consumer promote Path equality to operational interchangeability?"},
    {"id": "G7", "question": "Is a natural-use reality mismatch established in the frozen source set?"},
    {"id": "G8", "question": "Can the exact theory/checker slice be replayed natively with pinned inputs?"}
  ],
  "natural_usage_gate": {
    "verdict_on_pass": "NATURAL_USAGE_MISMATCH",
    "required_conditions": [
      "A fixed real implementation or application is named and source-pinned.",
      "The same dfix/application task is compared at forcing and ordinary ticks.",
      "The consumer explicitly uses Path equality as a license for same-step judgemental unfolding or current availability.",
      "The promotion does not add a syntax observer, host checker, clock family or other qualifying data.",
      "The consumer promises an operational result whose truth differs between the two tick forms.",
      "The exact promotion is natively replayed or rejected by the pinned checker."
    ]
  },
