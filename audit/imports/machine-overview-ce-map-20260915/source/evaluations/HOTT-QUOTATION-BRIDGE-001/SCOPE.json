    {"id": "H1", "name": "fixed_interface", "question": "Is the exact implementation or primary formal source fixed?"},
    {"id": "H2", "name": "role_meaning", "question": "Is the carrier's meaning fixed as checker computation, syntax/proof quotation or next-step availability?"},
    {"id": "H3", "name": "self_or_fix_closure", "question": "Which bind/cojoin/fix/Loeb operation is actually supplied, and at what type?"},
    {"id": "H4", "name": "elimination_scope", "question": "Can the carrier be eliminated to A, and what tick, clock, host or reflection premise is required?"},
    {"id": "H5", "name": "payment_device", "question": "Does the system explicitly preserve the host boundary, tick ordering, clock quantifier or typed-code evidence?"},
    {"id": "H6", "name": "natural_guard_erasure_consumer", "question": "Does a real fixed consumer erase that payment device and still promise the original task?"}
  ],
  "decision_rule": "A HoTT-specific mismatch candidate requires one fixed consumer with H1-H6 PASS. A native conditional collapse plus H6 FAIL is a guarded boundary/defense result, not an HoTT bug.",
