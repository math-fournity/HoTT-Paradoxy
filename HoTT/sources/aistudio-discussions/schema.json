{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hott-discussion-corpus-v1",
  "title": "HoTT discussion corpus manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_path",
    "source_instances",
    "source_root_id",
    "source_structure",
    "source_sha256",
    "source_bytes",
    "source_lines",
    "duplicate_source_count",
    "line_start",
    "line_end",
    "captured_lines",
    "extraction_modes",
    "anchor_counts",
    "anchor_match_lines",
    "topic_tags",
    "context_tags",
    "review_status",
    "excerpt_path",
    "verbatim_bytes",
    "verbatim_sha256",
    "excerpt_sha256",
    "manager_version"
  ],
  "properties": {
    "schema_version": { "const": "hott-discussion-corpus/v1" },
    "id": { "type": "string", "pattern": "^HOTT-DISC-[0-9A-F]{16}$" },
    "source_path": { "type": "string", "minLength": 1 },
    "source_instances": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "source_root_id": { "enum": ["aistudio_archive", "migrated_hott"] },
    "source_structure": { "enum": ["qa_dialogue", "prompt_response", "headed_prose", "unheaded_prose"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_bytes": { "type": "integer", "minimum": 0 },
    "source_lines": { "type": "integer", "minimum": 0 },
    "duplicate_source_count": { "type": "integer", "minimum": 1 },
    "line_start": { "type": "integer", "minimum": 1 },
    "line_end": { "type": "integer", "minimum": 1 },
    "captured_lines": { "type": "integer", "minimum": 1 },
    "extraction_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "anchor_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "anchor_match_lines": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "topic_tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "context_tags": { "type": "array", "items": { "type": "string" } },
    "review_status": { "const": "UNREVIEWED_RAW_CAPTURE" },
    "excerpt_path": { "type": "string", "pattern": "^excerpts/HOTT-DISC-[0-9A-F]{16}\\.md$" },
    "verbatim_bytes": { "type": "integer", "minimum": 0 },
    "verbatim_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "excerpt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manager_version": { "type": "string" }
  }
}
