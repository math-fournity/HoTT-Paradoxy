notCoh₃ : ¬ Coh₃ flatSurfᵢ
notCoh₃ h = σr≢refl (cong sym (seg3-inj (refl {x = north} ∙ refl ∙ refl ∙ refl) (sym σr) key))
  where
  open AtSurf
  key : P4.hem₁-1 flatSurfᵢ zero fzero fzero fzero (fsuc fzero) tt tt tt tt ≡ refl
  key = rUnit _ ∙ cong (P4.hem₁-1 flatSurfᵢ zero fzero fzero fzero (fsuc fzero) tt tt tt tt ∙_) (sym rest₁)
      ∙ h zero fzero fzero fzero (fsuc fzero) tt tt tt tt ∙ all₂

