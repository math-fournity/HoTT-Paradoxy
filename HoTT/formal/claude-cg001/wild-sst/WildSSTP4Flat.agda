  triv-hem₁-1 : P4.hem₁-1 flatTrivialᵢ zero i j k l p q s x ≡ refl
  triv-hem₁-1 = mv3-triv (λ (z : north ≡ north) → z) (refl {x = north} ∙ refl ∙ refl ∙ refl) refl
  triv-hem₁-2 : P4.hem₁-2 flatTrivialᵢ zero i j k l p q s x ≡ refl
  triv-hem₁-2 = mv3-triv (λ (z : north ≡ north) → refl ∙ refl ∙ z) (refl {x = north} ∙ refl) (cong sym (topFace-refl (λ (_ : Unit) → north) {a = refl} {b = refl} {c = refl}))
  triv-hem₁-3 : P4.hem₁-3 flatTrivialᵢ zero i j k l p q s x ≡ refl
