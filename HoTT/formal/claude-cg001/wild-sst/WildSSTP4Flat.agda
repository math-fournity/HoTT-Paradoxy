  triv-hem₁-6 : P4.hem₁-6 flatTrivialᵢ zero i j k l p q s x ≡ refl
  triv-hem₁-6 = mv3-triv (λ (z : north ≡ north) → z) (refl {x = north} ∙ refl ∙ refl ∙ refl) (cong sym (topFace-refl (λ (_ : Unit) → north) {a = refl} {b = refl} {c = refl}))
  triv-hem₂-1 : P4.hem₂-1 flatTrivialᵢ zero i j k l p q s x ≡ refl
